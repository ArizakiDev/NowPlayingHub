<UserControl x:Class="NowPlayingHub.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NowPlayingHub" Loaded="OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,36" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Système" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Connexion à la carte" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Adresse (nowplaying.local ou IP)" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding EspHost, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16"/>
          <TextBlock Text="Jeton de mise à jour (le même que sur la carte)" Style="{StaticResource Caption}"/>
          <PasswordBox x:Name="Tok" PasswordChanged="OnTokChanged" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding TokenWarning}" Foreground="{DynamicResource WarnBrush}" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal"><Button Content="Tester la connexion" Command="{Binding TestCommand}" Margin="0,4,12,0"/><TextBlock Text="{Binding TestResult}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Page de statut web" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Activer la page de statut" Tag="Disponibilité sur 30 jours et détail de la carte, dans un navigateur."><CheckBox IsChecked="{Binding StatusEnabled}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Accessible depuis le réseau local" Tag="Pour la consulter depuis un téléphone. Lecture seule, aucun jeton ni mot de passe exposé. Windows peut demander d'autoriser le pare-feu."><CheckBox IsChecked="{Binding StatusLan}"/></HeaderedContentControl>
          <TextBlock Text="Port" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding StatusPortText, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,14"/>
          <TextBlock Text="{Binding StatusUrls}" Style="{StaticResource Mono}" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding StatusError}" Foreground="{DynamicResource BadBrush}" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
          <Button Content="Ouvrir la page" Command="{Binding OpenStatusCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Application" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Lancer au démarrage de Windows" Tag="Démarre directement dans la zone de notification."><CheckBox IsChecked="{Binding Autostart_}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Fermer la fenêtre = réduire dans la zone de notification" Tag="Désactivé : fermer la fenêtre quitte l'application (la carte repasse en veille)."><CheckBox IsChecked="{Binding CloseToTray}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Translittérer en ASCII" Tag="Recommandé : les polices de la carte n'affichent pas les accents."><CheckBox IsChecked="{Binding AsciiOnly}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Fréquence de synchronisation" Tag="Délai entre deux envois à la carte."><StackPanel Orientation="Horizontal"><Slider Minimum="250" Maximum="3000" TickFrequency="50" Value="{Binding IntervalMs}"/><TextBlock Width="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding IntervalMs, StringFormat={}{0} ms}"/></StackPanel></HeaderedContentControl>
          <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Dim}"/>
          <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Dim}" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="La carte" Style="{StaticResource TileTitle}"/>
          <StackPanel Orientation="Horizontal"><Button Content="Redémarrer la carte" Command="{Binding RebootCommand}" Margin="0,0,10,0"/><Button Content="Oublier le Wi-Fi" Command="{Binding WifiResetCommand}"/></StackPanel>
          <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Journal" Style="{StaticResource TileTitle}"/>
          <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="190" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal"><Button Content="Actualiser" Command="{Binding RefreshLogCommand}" Margin="0,0,10,0"/><Button Content="Ouvrir le dossier" Command="{Binding OpenLogsCommand}"/></StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
