<UserControl x:Class="NowPlayingHub.FirmwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NowPlayingHub">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,36" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Firmware" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Version" Style="{StaticResource TileTitle}"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Firmware de la carte" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="{Binding CurrentVersion}" FontFamily="{StaticResource LightFont}" FontSize="28"/></StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Mise à jour depuis GitHub" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Dépôt (utilisateur/depot)" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding GithubRepo, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Vérifier au démarrage" Tag="Un point apparaît à côté de « Firmware » quand une nouvelle version existe."><CheckBox IsChecked="{Binding CheckUpdatesOnStart}"/></HeaderedContentControl>
          <StackPanel Orientation="Horizontal"><Button Content="Vérifier" Command="{Binding CheckCommand}" Margin="0,0,10,0"/><Button Content="Installer la dernière version" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}"/></StackPanel>
          <TextBlock Text="{Binding ResultText}" Style="{StaticResource Dim}" Margin="0,14,0,0"/>
          <TextBlock Text="{Binding Notes}" Style="{StaticResource Dim}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Depuis un fichier" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Choisis un firmware.bin (firmware/.pio/build/cyd/firmware.bin)." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <Button Content="Choisir un fichier .bin…" Command="{Binding PickFileCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Progression" Style="{StaticResource TileTitle}"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Dim}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
