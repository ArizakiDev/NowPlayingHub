<UserControl x:Class="NowPlayingHub.MusicView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NowPlayingHub" Loaded="OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,36" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Musique" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Application suivie" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Windows détecte les lecteurs ouverts. « Automatique » suit Cider, Apple Music ou iTunes." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Padding="0" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Mark" Background="Transparent"/>
                    <StackPanel Grid.Column="1" Margin="16,10" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Name}" FontSize="15"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Paroles synchronisées" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Afficher les paroles sur la carte" Tag="Titre, artiste, album et durée sont envoyés aux sources cochées pour la recherche."><CheckBox IsChecked="{Binding ShowLyrics}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="LRCLIB (lrclib.net)" Tag="Ouvert, sans clé."><CheckBox IsChecked="{Binding LyricsLrclib}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="NetEase Cloud Music" Tag="Très gros catalogue, sans clé."><CheckBox IsChecked="{Binding LyricsNetease}"/></HeaderedContentControl>
          <TextBlock Text="Musixmatch : jeton utilisateur (facultatif)" Style="{StaticResource Caption}"/>
          <PasswordBox x:Name="Mxm" PasswordChanged="OnMxmChanged" Margin="0,0,0,6"/>
          <TextBlock Text="Vide = Musixmatch désactivé. Cette source utilise l'API non officielle de leur application : elle peut cesser de fonctionner." Style="{StaticResource Dim}" Margin="0,0,0,18"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Décalage des paroles" Tag="Positif : plus tôt. Négatif : plus tard."><StackPanel Orientation="Horizontal"><Slider Minimum="-2000" Maximum="2000" TickFrequency="100" Value="{Binding LyricsOffsetMs}"/><TextBlock Width="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding LyricsOffsetMs, StringFormat={}{0} ms}"/></StackPanel></HeaderedContentControl>
          <TextBlock Text="{Binding LyricsStatus}" Style="{StaticResource Dim}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Visualiseur de spectre" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Envoyer le spectre audio à la carte" Tag="Le son du PC est analysé localement uniquement quand la carte affiche le spectre (ou la LED en mode basses). Seuls des niveaux sont envoyés, rien n'est enregistré."><CheckBox IsChecked="{Binding Visualizer}"/></HeaderedContentControl>
          <TextBlock Text="{Binding VizStatus}" Style="{StaticResource Dim}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Historique et cache" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Garder un historique d'écoute" Tag="Local à ce PC (%AppData%\NowPlayingHub). Alimente les statistiques de la page de statut."><CheckBox IsChecked="{Binding ListenHistory}"/></HeaderedContentControl>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
            <Button Content="Vider le cache des paroles" Command="{Binding ClearLyricsCacheCommand}" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Effacer l'historique" Command="{Binding ClearHistoryCommand}" Padding="14,8"/>
          </StackPanel>
          <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource Dim}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
