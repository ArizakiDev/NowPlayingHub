<UserControl x:Class="NowPlayingHub.HardwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NowPlayingHub">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,36" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Matériel" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Luminosité automatique" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Régler la luminosité avec le capteur" Tag="La luminosité varie entre 10 % et ton réglage. Mode nuit et veille restent prioritaires."><CheckBox IsChecked="{Binding AutoBrightness}"/></HeaderedContentControl>
          <TextBlock Text="{Binding LdrText}" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal"><Button Content="Il fait sombre" Command="{Binding CalDarkCommand}" Margin="0,0,10,0"/><Button Content="Il fait clair" Command="{Binding CalBrightCommand}"/></StackPanel>
          <TextBlock Text="Calibre le capteur : place la carte dans la situation voulue puis clique. Fonctionne quel que soit le sens du capteur." Style="{StaticResource Dim}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="LED RGB" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Mode" Style="{StaticResource Caption}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><RadioButton Style="{StaticResource Segment}" Content="Éteinte" IsChecked="{Binding LedIsOff}"/><RadioButton Style="{StaticResource Segment}" Content="Accent" IsChecked="{Binding LedIsAccent}"/><RadioButton Style="{StaticResource Segment}" Content="Pulsation" IsChecked="{Binding LedIsPulse}"/><RadioButton Style="{StaticResource Segment}" Content="Suit les basses" IsChecked="{Binding LedIsBass}"/></StackPanel>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Intensité"><StackPanel Orientation="Horizontal"><Slider Minimum="5" Maximum="100" Value="{Binding LedBrightness}"/><TextBlock Width="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding LedBrightness, StringFormat={}{0} %}"/></StackPanel></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Éteinte pendant le mode nuit"><CheckBox IsChecked="{Binding LedNightOff}"/></HeaderedContentControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Carte SD (cache de pochettes)" Style="{StaticResource TileTitle}"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Garder les pochettes sur la carte SD" Tag="Évite de renvoyer la pochette à chaque lecture. En cas de soucis de toucher, désactive-le."><CheckBox IsChecked="{Binding SdCache}"/></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Nombre de pistes gardées" Tag="Au-delà, les plus anciennes sont supprimées."><StackPanel Orientation="Horizontal"><Slider Minimum="20" Maximum="1000" TickFrequency="10" Value="{Binding SdMax}"/><TextBlock Width="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding SdMax, StringFormat={}{0}}"/></StackPanel></HeaderedContentControl>
          <TextBlock Text="{Binding SdText}" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <Button Content="Vider le cache" Command="{Binding ClearSdCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
