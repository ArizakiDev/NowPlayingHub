<UserControl x:Class="NowPlayingHub.IdleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NowPlayingHub">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,36,36" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Veille" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Lieu" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Météo, lever et coucher du soleil sont calculés pour ce lieu." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <TextBlock Text="Rechercher une ville" Style="{StaticResource Caption}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Rechercher" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}"/>
          </Grid>
          <TextBlock Text="{Binding SearchInfo}" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Chip}" Content="{Binding Label}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,9"
                        CommandParameter="{Binding}"
                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,16"/>
          <TextBlock Text="Nom affiché" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding LocationName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16"/>
          <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Latitude" Style="{StaticResource Caption}"/><TextBox Text="{Binding LatText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Longitude" Style="{StaticResource Caption}"/><TextBox Text="{Binding LonText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/></StackPanel></Grid>
          <TextBlock Text="{Binding WeatherText}" Style="{StaticResource Dim}" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Fuseau horaire" Style="{StaticResource TileTitle}"/>
          <TextBlock Text="Format POSIX : la carte gère seule le passage heure d'été / heure d'hiver." Style="{StaticResource Dim}" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding TimezonePresets}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Chip}" Content="{Binding Label}" CommandParameter="{Binding Value}"
                        Command="{Binding DataContext.TimezonePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding Timezone, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Actualités" Style="{StaticResource TileTitle}"/>
          <ItemsControl ItemsSource="{Binding RssPresets}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Chip}" Content="{Binding Label}" CommandParameter="{Binding Value}"
                        Command="{Binding DataContext.RssPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Adresse du flux RSS" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding NewsRssUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16"/>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Nombre d'actualités"><StackPanel Orientation="Horizontal"><Slider Minimum="1" Maximum="10" Value="{Binding NewsCount}"/><TextBlock Width="64" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding NewsCount, StringFormat={}{0}}"/></StackPanel></HeaderedContentControl>
          <TextBlock Text="{Binding NewsText}" Style="{StaticResource Dim}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
