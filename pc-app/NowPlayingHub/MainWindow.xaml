<Window x:Class="NowPlayingHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NowPlayingHub"
        Title="Now Playing Hub" Width="1120" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:HomeViewModel}"><local:HomeView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:DisplayViewModel}"><local:DisplayView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:IdleViewModel}"><local:IdleView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:MusicViewModel}"><local:MusicView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:HardwareViewModel}"><local:HardwareView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:StatusViewModel}"><local:StatusView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:FirmwareViewModel}"><local:FirmwareView/></DataTemplate>
    <DataTemplate DataType="{x:Type local:SystemViewModel}"><local:SystemView/></DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,16,18">
        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrush}">
          <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource OnAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Now Playing Hub" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="Carte Now Playing" Style="{StaticResource Dim}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Margin="8,8,8,12" Padding="14,10" CornerRadius="4" Background="{DynamicResource SubtleHoverBrush}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource OnlineDot}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding ConnText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
          </StackPanel>
          <TextBlock Text="{Binding SyncText}" Style="{StaticResource Dim}" Margin="19,4,0,0"/>
          <TextBlock Style="{StaticResource Dim}" Margin="19,4,0,0" Opacity="0.7"><Run Text="Version "/><Run Text="{x:Static local:AppInfo.Version}"/></TextBlock>
        </StackPanel>
      </Border>

      <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
               ItemsSource="{Binding Pages}" SelectedItem="{Binding Current, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Title}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
              <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                       Fill="{DynamicResource AccentBrush}"
                       Visibility="{Binding HasBadge, Converter={StaticResource B2V}}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource LineBrush}"
            Background="{DynamicResource ContentBrush}">
      <ContentControl x:Name="PageHost" Content="{Binding Current}" IsTabStop="False">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="PageShift"/>
        </ContentControl.RenderTransform>
      </ContentControl>
    </Border>
  </Grid>
</Window>
